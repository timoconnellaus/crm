---
import WaitlistForm from "./WaitlistForm.astro";
---

<section id="waitlist" class="final" aria-labelledby="waitlist-title">
  <div class="wrap reveal">
    <h2 id="waitlist-title">Be first on the hosted version.</h2>
    <p class="lead">We'll email you once, when it opens.</p>
    <WaitlistForm source="waitlist" teamSize />
    <p class="small">No newsletter, and no trackers on this site.</p>
  </div>
</section>
