---
import { CONTACT_EMAIL } from "../links.ts";
---

<section id="enterprise" class="tight-top" aria-labelledby="enterprise-title">
  <div class="wrap">
    <div class="ent glass reveal">
      <div>
        <span class="eyebrow">Enterprise</span>
        <h2 id="enterprise-title">We can run it for you.</h2>
        <p class="lead">
          A dedicated deployment, set up around your approval policies and the systems you already
          use, with a support agreement behind it.
        </p>
      </div>
      <a class="btn" href={`mailto:${CONTACT_EMAIL}`}>Talk to us</a>
    </div>
  </div>
</section>
