// ros-marketing: the landing page for relationshiposcrm.com (ADR 0191, Stage 9). Astro builds the
// static site into dist/; this Worker serves it as static assets and answers only /api/* itself
// (the waitlist and contact-sales form, stored in D1). No account or resource IDs are committed:
// wrangler provisions the D1 database by name on the first deploy. Deployed by
// .github/workflows/marketing.yml when its token secret is set; never from a laptop by default.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ros-marketing",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "relationshiposcrm.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ros-marketing",
      "migrations_dir": "./migrations",
      "migrations_table": "marketing_migrations"
    }
  ],
  // Form submissions per client IP, per minute (approximate, per Cloudflare location).
  "ratelimits": [
    { "name": "FORM_RATE_LIMIT", "namespace_id": "4301", "simple": { "limit": 5, "period": 60 } }
  ]
}
