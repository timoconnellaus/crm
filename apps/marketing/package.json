{
  "name": "@relationship-os/marketing",
  "version": "0.0.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "description": "The landing page for relationshiposcrm.com: a static Astro site served by a Worker that stores waitlist and contact-sales submissions in D1. No trackers.",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --port 4321",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check-static.mjs",
    "preview": "pnpm build && wrangler d1 migrations apply DB --local && wrangler dev",
    "deploy": "pnpm build && wrangler deploy && wrangler d1 migrations apply DB --remote",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "wrangler types --strict-vars=false --check && tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts",
    "og-image": "node scripts/og-image.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@playwright/test": "1.64.1",
    "@relationship-os/config": "workspace:*",
    "@types/node": "24.19.2",
    "astro": "7.4.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
