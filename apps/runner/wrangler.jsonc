// crm-runner: runs extension code, automations and Workflows (ADR 0004). Reached by crm-app over a
// service binding. Self-contained and account-agnostic: no account or resource IDs are committed
// (ADR 0012); wrangler provisions the D1 database by name on first deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crm-runner",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "allow_irrevocable_stub_storage"],
  // Internal only: crm-app reaches it through a service binding, never a public URL.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crm",
      "migrations_dir": "../../packages/db/migrations",
      "migrations_table": "core_migrations"
    }
  ],
  "workflows": [
    {
      "binding": "HELLO_WORKFLOW",
      "name": "crm-hello",
      "class_name": "HelloWorkflow"
    }
  ],
  // Worker Loader: the Dynamic Workers that run extension code (ADR 0006). Repeat code (tools,
  // manifest evaluation, the type checker) uses LOADER.get with a stable id; only Code Mode
  // scripts use LOADER.load (ADR 0043).
  "worker_loaders": [{ "binding": "LOADER" }],
  // The extension workspace (ADR 0025, ADR 0043): extension source under git and the build cache.
  // It runs no code. CODE_MODE_GATE: one per user, Code Mode's concurrency limit of 1.
  "durable_objects": {
    "bindings": [
      { "name": "EXTENSION_WORKSPACE", "class_name": "ExtensionWorkspace" },
      { "name": "CODE_MODE_GATE", "class_name": "CodeModeGate" },
      // Stage 6a (ADR 0110): one integration host per connection. It owns gatekeeper accounts,
      // facets and hooks (persistent RPC stubs need allow_irrevocable_stub_storage).
      { "name": "INTEGRATION_HOST", "class_name": "IntegrationHost" },
      // The fake provider (development and tests only; see INTEGRATIONS_FAKE_PROVIDER).
      { "name": "FAKE_ACCOUNT", "class_name": "FakeAccount" },
      { "name": "FAKE_PROVIDER", "class_name": "FakeProvider" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SpikeWorkspace"] },
    // Stage 3 replaced the stage 0 spike with the real extension workspace.
    {
      "tag": "v2",
      "deleted_classes": ["SpikeWorkspace"],
      "new_sqlite_classes": ["ExtensionWorkspace"]
    },
    // ADR 0043: Code Mode's per-user concurrency gate.
    { "tag": "v3", "new_sqlite_classes": ["CodeModeGate"] },
    // Stage 6a: the integration host, and the fake gatekeeper (its facet class included).
    {
      "tag": "v4",
      "new_sqlite_classes": ["IntegrationHost", "FakeAccount", "FakeProvider", "FakeGatekeeper"]
    }
  ],
  // Email bodies of synced mail (ADR 0112): D1 keeps a snippet only (cost audit U1).
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "crm-blobs" }],
  // Gatekeepers (ADR 0007): each is a Worker's GatekeeperVendor entrypoint, enabled per
  // deployment by an admin. Deploy the gatekeeper Workers you use and add their bindings here
  // (GATEKEEPER_GOOGLE → crm-gatekeeper-google, …); see docs/integrations.md. The fake provider
  // is crm-runner itself and answers only when INTEGRATIONS_FAKE_PROVIDER is "true".
  "services": [
    { "binding": "GATEKEEPER_FAKE", "service": "crm-runner", "entrypoint": "FakeGatekeeperVendor" }
  ],
  "vars": {
    // Extension code calls operations here (codemode:crm), so the runner applies the same
    // approval floor as crm-app. Keep the two in step. See docs/deploying.md.
    "APPROVAL_FLOOR": "",
    // codemode:ai and proposal summaries use the model role registry (ADR 0150), like crm-app:
    // keep these in step with apps/app/wrangler.jsonc. Workers AI needs an `ai` binding, added
    // by `pnpm run deploy` (CRM_AI, docs/deploying.md).
    "AI_GATEWAY_ID": "",
    "CLOUDFLARE_ACCOUNT_ID": "",
    "AI_MODEL_ROLES": "",
    "AI_PROVIDERS": "",
    // The CRM's public origin (https://crm.example.com), where connect popups are handed back.
    // crm-app passes the request's origin; this is the fallback.
    "APP_ORIGIN": "",
    // "true" offers the fake provider (development and e2e only; never in production).
    "INTEGRATIONS_FAKE_PROVIDER": "false"
  }
}
