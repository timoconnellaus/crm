  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "@crm/config": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
