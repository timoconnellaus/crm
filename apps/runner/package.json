{
  "name": "@relationship-os/runner",
  "version": "0.0.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "exports": {
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "dev": "node scripts/bundle.mjs && wrangler dev",
    "build": "node scripts/bundle.mjs && wrangler deploy --dry-run --outdir dist",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "node scripts/bundle.mjs && wrangler types --strict-vars=false --check && tsc --noEmit",
    "test": "node scripts/bundle.mjs && vitest run && node scripts/bundle-budget.mjs"
  },
  "dependencies": {
    "@cloudflare/computer": "0.9.0",
    "@relationship-os/core": "workspace:*",
    "@relationship-os/db": "workspace:*",
    "@relationship-os/sdk": "workspace:*",
    "@platformatic/vfs": "0.5.0",
    "kysely": "0.29.8",
    "sucrase": "3.35.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "@relationship-os/config": "workspace:*",
    "esbuild": "0.28.2",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
