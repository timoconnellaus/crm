{
  "name": "@crm/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/dev-setup.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "node ../../scripts/deploy.mjs",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "wrangler types --strict-vars=false --check && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node ../../scripts/dev-setup.mjs && playwright test"
  },
  "dependencies": {
    "@crm/auth": "workspace:*",
    "@crm/db": "workspace:*",
    "@crm/ui": "workspace:*",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "1.7.16",
    "lucide-react": "1.67.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/vitest-plugin": "1.5.1",
    "@crm/config": "workspace:*",
    "@crm/runner": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jose": "6.2.15",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  },
  "cloudflare": {
    "bindings": {
      "BETTER_AUTH_SECRET": {
        "description": "Signs sessions. At least 32 random characters, e.g. the output of `openssl rand -hex 32`."
      },
      "BETTER_AUTH_URL": {
        "description": "Public origin of the app, e.g. https://crm.example.com. Optional: inferred from requests when empty."
      },
      "GOOGLE_CLIENT_ID": {
        "description": "Optional. Google OAuth client ID for Google sign-in."
      },
      "GOOGLE_CLIENT_SECRET": {
        "description": "Optional. Google OAuth client secret for Google sign-in."
      },
      "CF_ACCESS_TEAM_DOMAIN": {
        "description": "Only with IDENTITY_PROVIDER=cloudflare-access: your team domain."
      },
      "CF_ACCESS_AUD": {
        "description": "Only with IDENTITY_PROVIDER=cloudflare-access: the Access application's AUD tag."
      }
    }
  }
}
