# crm-app secrets. The Deploy to Cloudflare button asks for these; `wrangler secret put` sets them
# on a deployed Worker (docs/deploying.md). For local development `pnpm dev` copies this file to
# .dev.vars when missing, generates BETTER_AUTH_SECRET and adds AUTH_ALLOW_SIGNUP=true.

# Signs sessions: at least 32 random characters (openssl rand -hex 32). Required.
BETTER_AUTH_SECRET=
# Public origin of the app, e.g. https://crm.example.com. Empty: inferred from the request.
BETTER_AUTH_URL=

# Google sign-in (optional). OAuth redirect URI: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Access (only with IDENTITY_PROVIDER=cloudflare-access in wrangler.jsonc).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Self-updater (optional): a scoped Cloudflare API token so Settings → Updates can update this
# deployment itself. Permissions are listed in docs/deploying.md. Leave empty to update with the
# `crm upgrade` CLI instead.
CRM_UPDATE_TOKEN=

# Local only, never in production: "true" answers every model role with deterministic stand-ins
# and keeps vectors in memory when there is no `ai` binding (ADR 0156). `pnpm dev` adds it.
# AI_FAKE_MODEL=

# Settings → AI (optional, docs/deploying.md "In-app AI"): a Cloudflare API token for provider
# keys and usage, an authenticated AI Gateway token, and provider keys (never stored in D1).
# CLOUDFLARE_API_TOKEN=
# AI_GATEWAY_TOKEN=
# AI_KEY_OPENAI=
