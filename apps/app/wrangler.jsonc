// crm-app: TanStack Start UI and server functions (ADR 0004). Self-contained and account-agnostic:
// no account or resource IDs are committed (ADR 0012); wrangler provisions the D1 database by name
// on first deploy. Secrets are listed in .dev.vars.example and docs/deploying.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crm-app",
  // TanStack Start's entry plus a `scheduled` handler (src/server.ts).
  "main": "./src/server.ts",
  // Daily maintenance: Trash purge (ADR 0018), approvals, storage retention (ADR 0090). Every 10
  // minutes: the embedding catch-up for semantic search (ADR 0154; does nothing without AI).
  "triggers": { "crons": ["17 3 * * *", "*/10 * * * *"] },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crm",
      "migrations_dir": "../../packages/db/migrations",
      "migrations_table": "core_migrations"
    }
  ],
  // Secrets are set with `wrangler secret put` and never committed. Optional ones (BETTER_AUTH_URL,
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, CF_ACCESS_TEAM_DOMAIN, CF_ACCESS_AUD) are listed in
  // .dev.vars.example and docs/deploying.md.
  "secrets": { "required": ["BETTER_AUTH_SECRET"] },
  "services": [{ "binding": "RUNNER", "service": "crm-runner" }],
  // Synced email bodies (ADR 0112), shared with crm-runner: D1 keeps a snippet only.
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "crm-blobs" }],
  // OAuth 2.1 for /mcp (ADR 0021): clients, grants and hashed tokens. Provisioned by name on
  // first deploy, like the D1 database.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // Workers Rate Limiting (ADR 0056, docs/deploying.md). Limits are per Cloudflare location and
  // approximate; change them here and redeploy. namespace_id must be an integer unique within
  // the account: change these if another Worker in your account already uses them.
  "ratelimits": [
    // Every /mcp request, per connected app.
    { "name": "MCP_RATE_LIMIT", "namespace_id": "4101", "simple": { "limit": 120, "period": 60 } },
    // Non-read operations over MCP, per connected app.
    {
      "name": "MCP_WRITE_RATE_LIMIT",
      "namespace_id": "4102",
      "simple": { "limit": 30, "period": 60 }
    },
    // Code Mode runs, per user.
    {
      "name": "CODE_MODE_RATE_LIMIT",
      "namespace_id": "4103",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    // better-auth (default) or cloudflare-access. See docs/deploying.md.
    "IDENTITY_PROVIDER": "better-auth",
    // Only the first user may sign up unless this is "true".
    "AUTH_ALLOW_SIGNUP": "false",
    // Approval-policy floor (ADR 0011): JSON rules the org's preset can never loosen, e.g.
    // {"*":{"destructive":"review"}}. Empty means no floor. See docs/deploying.md.
    "APPROVAL_FLOOR": "",
    // Days before a pending action (an AI change waiting for approval) expires (ADR 0022).
    "APPROVAL_EXPIRY_DAYS": "7",
    // MCP rate limits are the `ratelimits` bindings above (ADR 0056).
    // MCP access token lifetime in seconds; refresh tokens last 30 days.
    "MCP_ACCESS_TOKEN_TTL": "3600",
    // In-app AI (ADRs 0009, 0150-0155). Model roles need an `ai` binding and semantic search a
    // `vectorize` binding; both are optional and added by `pnpm run deploy` (CRM_AI, see
    // docs/deploying.md). Without them AI features say AI is not configured.
    // AI Gateway id: every model call goes through it when set (usage and spend per role).
    "AI_GATEWAY_ID": "",
    // The Cloudflare account id: AI Gateway URLs for non-Workers-AI providers, and Settings → AI
    // (keys as Workers secrets, usage) together with the CLOUDFLARE_API_TOKEN secret.
    "CLOUDFLARE_ACCOUNT_ID": "",
    // Deploy-config layer of the model registry: JSON role → { provider, model, params, fallback }.
    "AI_MODEL_ROLES": "",
    // Base URLs for the `jev` and `openai-compatible` providers: JSON { "<provider>": { "baseURL" } }.
    "AI_PROVIDERS": "",
    // Size of the Vectorize index (`crm-records`); the embed role must produce this many dims.
    "VECTORIZE_DIMENSIONS": "384",
    // Worker scripts Settings → AI stores provider keys on (as Workers secrets).
    "AI_SECRET_SCRIPTS": "crm-app,crm-runner",
    // Local dev and e2e only (.dev.vars sets it): "true" answers the build role with a
    // deterministic stand-in when there is no `ai` binding. Never set it in production.
    "AI_FAKE_MODEL": ""
  }
}
