// Local dev and e2e for ros-control: PLATFORM_MODE=fake with every external system faked
// (Cloudflare API with a Workers for Platforms namespace, Stripe, email), jobs inline. Never deployed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ros-control-e2e",
  "main": "./src/testing/fake-worker.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ros-control-e2e",
      "database_id": "local-ros-control-e2e",
      "migrations_dir": "./migrations",
      "migrations_table": "control_migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "ROUTES", "id": "local-routes" }],
  "queues": { "producers": [{ "binding": "JOBS", "queue": "ros-control-jobs-e2e" }] },
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    {
      "name": "SIGNUP_RATE_LIMIT",
      "namespace_id": "4311",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": { "bindings": [{ "name": "FAKE_D1", "class_name": "FakeD1Database" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FakeD1Database"] }],
  "vars": {
    "PLATFORM_MODE": "fake",
    "JOBS_INLINE": "on",
    "SAAS_DOMAIN": "relationshiposcrm.com",
    "CONTROL_ORIGIN": "http://localhost:8790",
    "MAIL_FROM": "Relationship OS <hello@relationshiposcrm.com>",
    "DISPATCH_NAMESPACE": "ros-customers",
    "DEFAULT_PLACEMENT": "namespace",
    "RELEASE_CHANNEL": "stable",
    "STAFF_EMAILS": "staff@relationshiposcrm.com",
    "AI_MARKUP_PERCENT": "20",
    "PLATFORM_AI_PROVIDERS": "workers-ai",
    "IDLE_PAUSE_DAYS": "60",
    "DELETE_GRACE_DAYS": "30",
    "TRIAL_DAYS": "14",
    "ROLLOUT_SOAK_SECONDS": "0",
    "SUPPORT_PUBLIC_KEY": "",
    "STRIPE_PRICE_TEAM": "",
    "STRIPE_PRICE_BUSINESS": "",
    "STRIPE_PRICE_AI_OVERAGE": "",
    "STRIPE_METER_EVENT": "ai_overage_cents"
  }
}
