// ros-gatekeeper-email: the inbound-email gatekeeper vendored from cloudflare-os
// (packages/gatekeeper-email). Upstream generates its wrangler.jsonc from cloudflare.config.ts; we
// keep this file as the source of truth instead, with the same settings plus our name and no
// public URL. Account-agnostic: no account or resource IDs are committed (ADR 0012). Not yet bound
// to ros-runner (stage 6).
//
// It receives mail only: a Cloudflare Email Routing rule sends messages to this Worker's `email`
// handler, which hands them to the hook bound for the address's local part. No secrets. Optional:
// BASE_URL, the base its mailbox resource URLs and connect pages are built from (defaults to the
// local dev server's). See README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ros-gatekeeper-email",
  // capnweb-validate writes the validated entrypoint here (see `build`); wrangler bundles that.
  "main": ".wrangler/validate/src/email.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_als"],
  // Internal only for now: reached through service bindings and Email Routing.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "rules": [{ "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false }],
  "migrations": [
    { "tag": "v0", "new_sqlite_classes": ["UserAccount", "EmailGatekeeperImpl", "EmailAddress"] }
  ]
}
