// crm-gatekeeper-zoominfo: the ZoomInfo gatekeeper vendored from cloudflare-os
// (packages/gatekeeper-zoominfo). Upstream generates its wrangler.jsonc from cloudflare.config.ts;
// we keep this file as the source of truth instead, with the same settings plus our name and no
// public URL. Account-agnostic: no account or resource IDs are committed (ADR 0012). Not yet bound
// to crm-runner (stage 6).
//
// Secrets (not committed; set with `wrangler secret put`): CLIENT_ID and CLIENT_SECRET (a ZoomInfo
// OAuth app with a redirect URI of <public base>/gatekeeper/zoominfo/oauth). Optional: BASE_URL,
// the public base the OAuth redirect is built from. See README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crm-gatekeeper-zoominfo",
  // capnweb-validate writes the validated entrypoint here (see `build`); wrangler bundles that.
  "main": ".wrangler/validate/src/zoominfo.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["allow_irrevocable_stub_storage"],
  // Internal only for now: reached through service bindings. OAuth callbacks will be proxied to it
  // by crm-app when stage 6 wires it in.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "rules": [{ "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false }],
  "migrations": [{ "tag": "v0", "new_sqlite_classes": ["UserAccount", "ZoomInfoGatekeeperImpl"] }]
}
