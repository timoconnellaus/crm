{
  "name": "@relationship-os/gatekeeper-websearch",
  "version": "0.0.0",
  "private": true,
  "description": "Gatekeeper Worker for web search through Workers AI's websearch() and AI Gateway. Vendored from cloudflare-os.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/worker.ts",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "types": "node ../../scripts/gatekeeper-worker-types.mjs",
    "typecheck": "node ../../scripts/gatekeeper-worker-types.mjs --check && tsc --noEmit",
    "test": "vitest run && vitest run -c vitest.smoke.config.ts"
  },
  "dependencies": {
    "@relationship-os/gatekeeper-interface": "workspace:*",
    "@relationship-os/gatekeeper-kit": "workspace:*",
    "capnweb": "0.12.0",
    "capnweb-validate": "0.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "@relationship-os/config": "workspace:*",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
