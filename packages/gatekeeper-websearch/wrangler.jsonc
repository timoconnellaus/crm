// crm-gatekeeper-websearch: the Web Search gatekeeper vendored from cloudflare-os
// (packages/gatekeeper-websearch). Upstream generates its wrangler.jsonc from cloudflare.config.ts;
// we keep this file as the source of truth instead, with the same settings plus our name and no
// public URL. Account-agnostic: no account or resource IDs are committed (ADR 0012). Not yet bound
// to crm-runner (stage 6).
//
// No secrets and no connect flow: the host mints its account with createAccount(). Optional var:
// CF_AI_GATEWAY, the AI Gateway searches go through (defaults to the account's `default` gateway,
// which must be in this Worker's own account). See README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crm-gatekeeper-websearch",
  // capnweb-validate writes the validated entrypoint here (see `build`); wrangler bundles that.
  "main": ".wrangler/validate/src/worker.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["allow_irrevocable_stub_storage"],
  // Internal only: reached through service bindings.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  // Workers AI's websearch(). It always runs remotely and is billed to the account's AI Gateway.
  "ai": { "binding": "AI" },
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": false }],
  // The workspace facet is reached through ctx.exports; no binding is required.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WebSearchGatekeeper"] }]
}
