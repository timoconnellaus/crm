// ros-gatekeeper-google: the Google Workspace gatekeeper vendored from cloudflare-os
// (packages/gatekeeper-google). Upstream generates its wrangler.jsonc from cloudflare.config.ts; we
// keep this file as the source of truth instead, with the same settings plus our name and no
// public URL. Account-agnostic: no account or resource IDs are committed (ADR 0012). Not yet bound
// to ros-runner (stage 6).
//
// Secrets (not committed; set with `wrangler secret put`): CLIENT_ID and CLIENT_SECRET (a Google
// OAuth "Web application" client), plus PUBSUB_CHAT_TOPIC, PUBSUB_GMAIL_TOPIC and
// PUBSUB_PUSH_SERVICE_ACCOUNT for push hooks. See README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ros-gatekeeper-google",
  // capnweb-validate writes the validated entrypoint here (see `build`); wrangler bundles that.
  "main": ".wrangler/validate/src/google.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_als"],
  // Internal only for now: reached through service bindings. OAuth callbacks and Pub/Sub pushes
  // will be proxied to it by ros-app when stage 6 wires it in.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  // Workers AI's toMarkdown(), which converts Drive PDFs to text.
  "ai": { "binding": "AI" },
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "rules": [{ "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false }],
  "migrations": [
    { "tag": "v0", "new_sqlite_classes": ["UserAccount", "GmailGatekeeperImpl"] },
    { "tag": "v1", "new_sqlite_classes": ["BigQueryGatekeeperImpl"] },
    { "tag": "v2", "new_sqlite_classes": ["GoogleCalendarGatekeeperImpl"] },
    { "tag": "v3", "new_sqlite_classes": ["GoogleSheetsGatekeeperImpl"] },
    { "tag": "v4", "new_sqlite_classes": ["GoogleDriveGatekeeperImpl", "GoogleDocGatekeeperImpl"] },
    { "tag": "v5", "new_sqlite_classes": ["GoogleChatGatekeeperImpl"] },
    { "tag": "v6", "new_sqlite_classes": ["ChatHookDriver"] },
    { "tag": "v7", "new_sqlite_classes": ["GmailHookDriver"] },
    { "tag": "v8", "new_sqlite_classes": ["GoogleSlidesGatekeeperImpl"] }
  ]
}
