// ros-gatekeeper-microsoft: the Microsoft 365 gatekeeper vendored from cloudflare-os
// (packages/gatekeeper-microsoft). Upstream generates its wrangler.jsonc from cloudflare.config.ts;
// we keep this file as the source of truth instead, with the same settings plus our name and no
// public URL. Account-agnostic: no account or resource IDs are committed (ADR 0012). Not yet bound
// to ros-runner (stage 6).
//
// Secrets (not committed; set with `wrangler secret put`): CLIENT_ID and CLIENT_SECRET (an Entra ID
// app registration with a Web redirect URI of <public base>/gatekeeper/microsoft/oauth) and
// MICROSOFT_TENANT_ID. Optional settings, all with in-code defaults: BASE_URL (a public https base
// turns on Graph change notifications), MICROSOFT_ALLOWED_TENANT_IDS, MICROSOFT_SHAREPOINT_ACCESS,
// MICROSOFT_OUTLOOK_ACCESS, MICROSOFT_CALENDAR_ACCESS and MICROSOFT_SHAREPOINT_SITES. See README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ros-gatekeeper-microsoft",
  // capnweb-validate writes the validated entrypoint here (see `build`); wrangler bundles that.
  "main": ".wrangler/validate/src/microsoft.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_als"],
  // Internal only for now: reached through service bindings. OAuth callbacks and Graph change
  // notifications will be proxied to it by ros-app when stage 6 wires it in.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  // Workers AI's toMarkdown(), which turns PDFs into text. Optional: without it a PDF is described
  // rather than read.
  "ai": { "binding": "AI" },
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "rules": [{ "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false }],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": [
        "UserAccount",
        "SharePointGatekeeper",
        "OutlookGatekeeper",
        "OutlookHookDriver",
        "CalendarGatekeeper"
      ]
    }
  ]
}
