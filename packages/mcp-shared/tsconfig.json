// Local change: upstream type-checks against a committed `worker-configuration.d.ts` holding only
// runtime types (this library has no Worker config, so no Env). We use the equivalent
// @cloudflare/workers-types package instead of committing a generated copy.
{
  "extends": "@relationship-os/config/tsconfig.vendored.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types/experimental"]
  },
  "include": ["src"]
}
