{
  "extends": "@relationship-os/config/tsconfig.base.json",
  "compilerOptions": {
    // `Symbol.dispose` on RPC stubs.
    "lib": ["ESNext"],
    // tsc checks the vendored @relationship-os/gatekeeper-interface and gatekeeper-kit sources we import (they
    // ship .ts, so skipLibCheck does not cover them), and upstream does not index-check. Our own
    // code is otherwise held to the full base config.
    "noUncheckedIndexedAccess": false,
    // The configurator spec module (src/configurator/*.tsx) uses the authoring API's `h`.
    "jsx": "react",
    "jsxFactory": "h",
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"]
  },
  "include": ["src", "__tests__", "worker-configuration.d.ts"]
}
