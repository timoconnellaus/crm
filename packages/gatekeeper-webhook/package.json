{
  "name": "@relationship-os/gatekeeper-webhook",
  "version": "0.0.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "description": "Gatekeeper Worker for inbound webhooks: verifies provider signatures and delivers typed events to a bound hook.",
  "type": "module",
  "main": "./src/worker.ts",
  "exports": {
    ".": "./src/worker.ts",
    "./types": "./src/types.d.ts",
    "./configurator/endpoint": "./src/configurator/endpoint-configurator-ui.tsx"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "types": "wrangler types",
    "typecheck": "wrangler types --check && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@relationship-os/gatekeeper-configurator-ui": "workspace:*",
    "@relationship-os/gatekeeper-interface": "workspace:*",
    "@relationship-os/gatekeeper-kit": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "@relationship-os/config": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
