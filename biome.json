{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "extends": ["./packages/config/biome-preset.json"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/worker-configuration.d.ts",
      "!**/routeTree.gen.ts",
      "!**/.wrangler",
      "!**/dist",
      "!**/playwright-report",
      "!**/test-results",
      "!**/*.md",
      "!docs/stages/assets",
      "!packages/gatekeeper-interface/src",
      "!packages/gatekeeper-interface/testing",
      "!packages/gatekeeper-observability/src",
      "!packages/gatekeeper-observability/__tests__",
      "!packages/gatekeeper-configurator-ui/src",
      "!packages/gatekeeper-kit/src",
      "!packages/gatekeeper-kit/__tests__",
      "!packages/mcp-shared/src",
      "!packages/mcp-shared/__tests__",
      "!packages/gatekeeper-mcp/src",
      "!packages/gatekeeper-mcp/__tests__",
      "!packages/gatekeeper-google/src",
      "!packages/gatekeeper-google/__tests__"
    ]
  },
  "overrides": [
    {
      "includes": ["packages/ui/src/components/**", "packages/ui/src/hooks/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDocumentCookie": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          }
        }
      }
    }
  ]
}
