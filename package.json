{
  "name": "relationship-os",
  "version": "0.0.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @relationship-os/app dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && node scripts/check-agent-imports.mjs && node --test scripts/check-agent-imports.test.mjs scripts/smoke-deployment.test.mjs",
    "format": "biome check --write .",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @relationship-os/app test:e2e",
    "deploy": "node scripts/deploy.mjs",
    "types": "turbo run types",
    "db:seed": "pnpm --filter @relationship-os/db seed",
    "upstream:check": "node scripts/upstream-sync-check.mjs",
    "ai:replay-cache": "node scripts/ai-replay-cache.mjs",
    "eval:calibrate": "pnpm --filter @relationship-os/evals-judge calibrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
