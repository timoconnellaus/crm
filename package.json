{
  "name": "crm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @crm/app dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @crm/app test:e2e",
    "deploy": "node scripts/deploy.mjs",
    "types": "turbo run types",
    "db:seed": "pnpm --filter @crm/db seed",
    "upstream:check": "node scripts/upstream-sync-check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
